// Deploy = push ke main (Cloudflare Workers Builds, akun Terangin). Jangan `wrangler deploy` dari laptop:
// wrangler di laptop login ke akun lain. account_id dipasang biar build nggak nyasar akun.
{
  "name": "formh5p",
  "main": "src/worker.js",
  "account_id": "f6fc9a7d05c10b4d6725ba37e5fa86da",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "nyalain.kitaterangin.id/uji*", "zone_name": "kitaterangin.id" }],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "uji-ut", "database_id": "6e1df5c7-c3c2-4d1a-90f9-b74645a2cfbb" }],
  "observability": { "enabled": true }
}
